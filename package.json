{
  "name": "north-stone-photography",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-photos.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-photos.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "photos": "node scripts/prepare-photos.mjs",
    "test": "node scripts/prepare-photos.mjs && node --test tests/*.test.mjs",
    "test:browser": "node scripts/check-browser.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@playwright/test": "1.64.0",
    "sharp": "0.35.5",
    "vite": "8.3.3"
  }
}
